# Application
PROJECT_NAME="Inkscape AI Beta"
DEBUG=true
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8000"

# LLM chat: openai | gemini | anthropic | groq | bedrock
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEFAULT_LLM_MODEL=gemini-2.5-flash

# AWS Bedrock (only when LLM_PROVIDER=bedrock)
# DEFAULT_LLM_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_REGION=us-east-1
# Simple auth: one Bedrock API key (Bedrock console -> API keys). Recommended.
AWS_BEARER_TOKEN_BEDROCK=
# OR classic IAM credentials (leave the bearer token empty if you use these)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=4096

# RAG — LlamaCloud hosted index (Settings → API Keys; Index → pipeline ID)
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_PIPELINE_ID=
# LLAMA_CLOUD_PROJECT_ID=
LLAMA_CLOUD_RETRIEVAL_TOP_K=8
LLAMA_CLOUD_ENABLE_RERANKING=true

# Storage
DATA_DIR=./data
DOCS_DIR=../docs
SESSION_TTL_DAYS=7
MAX_SVG_BYTES=5242880

# Database — leave empty for local SQLite (DATA_DIR/app.db).
# Set to a Postgres URL (e.g. Supabase) for durable, managed persistence.
# URL-encode special characters in the password (@ -> %40, % -> %25, ( -> %28).
# For servers without IPv6 (e.g. EC2), use the Supabase "Session pooler" host.
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.fgpabsrfbrjhfrhkgpox.supabase.co:5432/postgres
DATABASE_URL=

# Analytics + private admin dashboard
# Master switch for journey analytics (visitors, sessions, chats, events).
ANALYTICS_ENABLED=true
# Anonymous visitor cookie name.
VISITOR_COOKIE_NAME=vid
# Cookies default to Secure in production and non-Secure in DEBUG. Override if needed.
# COOKIE_SECURE=false
# Secret bearer token for the admin dashboard (admin/index.html). Leave empty to
# disable the admin API entirely. Use a long random string in production.
ADMIN_TOKEN=
