# Application
PROJECT_NAME="Inkscape AI Beta"
DEBUG=true
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8000"

# LLM chat: openai | gemini | anthropic | groq
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEFAULT_LLM_MODEL=gemini-2.5-flash
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=4096

# RAG — LlamaCloud hosted index (Settings → API Keys; Index → pipeline ID)
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_PIPELINE_ID=
# LLAMA_CLOUD_PROJECT_ID=
LLAMA_CLOUD_RETRIEVAL_TOP_K=8
LLAMA_CLOUD_ENABLE_RERANKING=true

# Storage
DATA_DIR=./data
DOCS_DIR=../docs
SESSION_TTL_DAYS=7
MAX_SVG_BYTES=5242880
