# Application
PROJECT_NAME="Inkscape AI Beta"
DEBUG=true
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8000"

# LLM chat: openai | gemini | anthropic | groq
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEFAULT_LLM_MODEL=gemini-2.5-flash
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=4096

# Embeddings (RAG) — still OpenAI today; optional for dev if you skip corpus indexing
EMBEDDING_MODEL=text-embedding-3-small

# Storage
DATA_DIR=./data
DOCS_DIR=../docs
SESSION_TTL_DAYS=7
MAX_SVG_BYTES=5242880
